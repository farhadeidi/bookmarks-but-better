{
  "name": "bookmarks-but-better-website",
  "private": true,
  "version": "4.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run build:preview && vite",
    "build": "bun run build:preview && vite build",
    "build:preview": "vite build --config vite.preview.config.ts --mode development",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.preview.json --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.5",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.2.1",
    "clsx": "^2.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  }
}
