{
  "name": "bookmarks-but-better-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:preview && astro dev",
    "build": "bun run build:preview && astro build",
    "build:preview": "vite build --config vite.preview.config.ts --mode development",
    "preview": "astro preview",
    "typecheck": "astro check && tsc -p tsconfig.preview.json --noEmit"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "0.42.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "~7.3.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  }
}
