---
import type { GetStaticPaths } from "astro"
import { getCollection, render, type CollectionEntry } from "astro:content"
import InstallButtons from "../../components/InstallButtons.astro"
import BaseLayout from "../../layouts/BaseLayout.astro"
import { formatDate } from "../../lib/guides"
import { PAGES } from "../../lib/pages"
import { article, breadcrumbs } from "../../lib/seo"
import { SITE } from "../../lib/site"

export const getStaticPaths = (async () => {
  const guides = await getCollection("guides")
  return guides.map((guide) => ({ params: { id: guide.id }, props: { guide } }))
}) satisfies GetStaticPaths

interface Props {
  guide: CollectionEntry<"guides">
}

const { guide } = Astro.props
const { Content } = await render(guide)
const { title, description, publishedAt, updatedAt } = guide.data
const path = `/guides/${guide.id}/`

const LINK =
  "underline decoration-primary/60 underline-offset-4 hover:text-primary"
---

<BaseLayout
  title={`${title} — ${SITE.name}`}
  description={description}
  ogType="article"
  jsonLd={[
    article({
      title,
      description,
      url: new URL(path, SITE.url).href,
      publishedAt,
      updatedAt,
    }),
    breadcrumbs([
      { name: "Home", path: "/" },
      { name: "Guides", path: PAGES.guides.path },
      { name: title, path },
    ]),
  ]}
>
  <article class="mx-auto max-w-3xl px-6 py-16 md:py-24">
    <nav aria-label="Breadcrumb" class="text-sm text-muted-foreground">
      <ol role="list" class="flex flex-wrap items-center gap-2">
        <li><a href="/" class={LINK}>Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={PAGES.guides.path} class={LINK}>Guides</a></li>
      </ol>
    </nav>
    <header class="mt-6">
      <h1
        class="font-display max-w-[30ch] text-4xl font-medium tracking-tight text-balance md:text-5xl"
      >
        {title}
      </h1>
      <p
        class="mt-5 max-w-[56ch] text-base/7 text-pretty text-muted-foreground sm:text-lg/8"
      >
        {description}
      </p>
      <p class="mt-4 text-sm text-muted-foreground">
        Published <time datetime={publishedAt.toISOString()}
          >{formatDate(publishedAt)}</time
        >
        {
          updatedAt && (
            <>
              {" "}
              · Updated{" "}
              <time datetime={updatedAt.toISOString()}>
                {formatDate(updatedAt)}
              </time>
            </>
          )
        }
      </p>
    </header>

    <div class="prose mt-12">
      <Content />
    </div>

    <aside
      class="mt-16 rounded-lg bg-card p-6 ring-1 ring-border"
      aria-labelledby="guide-cta"
    >
      <h2 id="guide-cta" class="font-display text-xl font-medium tracking-tight">
        Try Bookmarks But Better
      </h2>
      <p class="mt-2 text-base/7 text-pretty text-muted-foreground sm:text-sm/6">
        {SITE.tagline} Or <a href="/preview/" class={LINK}>try the live preview</a
        > first.
      </p>
      <InstallButtons class="mt-5" />
    </aside>
  </article>
</BaseLayout>
