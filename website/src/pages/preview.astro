---
import AppPreview from "../components/AppPreview.astro"
import BaseLayout from "../layouts/BaseLayout.astro"
import { PAGES } from "../lib/pages"
---

<BaseLayout
  title={PAGES.preview.title}
  description={PAGES.preview.description}
  noindex
>
  <div class="mx-auto max-w-7xl px-6 py-12 md:py-16">
    <div class="text-center">
      <p class="font-display text-sm text-primary italic">Live preview</p>
      <h1
        class="font-display mx-auto mt-2 max-w-[30ch] text-4xl font-medium tracking-tight text-balance md:text-5xl"
      >
        The real thing, running right now
      </h1>
      <p
        class="mx-auto mt-5 max-w-[52ch] text-base/7 text-pretty text-muted-foreground sm:text-lg/8"
      >
        This is the actual extension, not a video, with a simulated bookmark
        library. Browse it, drag things, open settings, switch sources and
        themes. Your changes persist in this browser, just like the real new tab
        page.
      </p>
    </div>
    <div class="mt-10">
      <AppPreview autoload tall />
    </div>
    <p
      class="mx-auto mt-6 max-w-[52ch] text-center text-base/7 text-pretty text-muted-foreground sm:text-sm/6"
    >
      The preview runs entirely in your browser against seeded demo data, with
      public favicon lookups for real site icons. No extension, no daemon, and
      no bookmarks of yours are involved.
    </p>
  </div>
</BaseLayout>
