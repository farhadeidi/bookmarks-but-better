---
import Faq from "../components/Faq.astro"
import Features from "../components/Features.astro"
import Hero from "../components/Hero.astro"
import PrivacyPledge from "../components/PrivacyPledge.astro"
import Sources from "../components/Sources.astro"
import ThemesGallery from "../components/ThemesGallery.astro"
import TrustStrip from "../components/TrustStrip.astro"
import SiteLayout from "../layouts/SiteLayout.astro"
import { FAQ_ITEMS } from "../lib/faq-items"
import { PAGES } from "../lib/pages"
import { faqPage, softwareApplication } from "../lib/seo"
---

<SiteLayout
  title={PAGES.home.title}
  description={PAGES.home.description}
  searchable={false}
  jsonLd={[softwareApplication(), faqPage(FAQ_ITEMS)]}
>
  <Hero />
  <TrustStrip />
  <Features />
  <Sources />
  <ThemesGallery />
  <PrivacyPledge />
  <Faq items={FAQ_ITEMS} />
</SiteLayout>
