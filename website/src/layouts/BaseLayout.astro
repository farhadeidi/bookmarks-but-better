---
import "../styles/global.css"
import BaseHead, { type Props as HeadProps } from "../components/BaseHead.astro"
import SiteFooter from "../components/SiteFooter.astro"
import SiteHeader from "../components/SiteHeader.astro"

export type Props = HeadProps
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...Astro.props} />
  </head>
  <body class="min-h-dvh bg-background font-sans text-foreground antialiased">
    <a
      href="#main"
      class="sr-only rounded-md bg-card px-4 py-2 text-sm ring-1 ring-border focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60]"
    >
      Skip to content
    </a>
    <SiteHeader />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
