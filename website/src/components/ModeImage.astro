---
/**
 * A screenshot in two versions, one per site mode. Both are in the document;
 * the `dark` class on <html> (theme-init.ts) decides which one is displayed,
 * so the images follow the theme toggle, not only the system preference.
 *
 * Loading: `eager` applies to both versions, because either one can be the LCP
 * element and the mode is only known in the browser. Marking just one of them
 * would hand the high-priority slot to an image the visitor may not be shown
 * and demote the one they are. `display:none` keeps the unused variant off the
 * page either way.
 *
 * The trade-off is that a visitor fetches both versions of an `eager` image
 * rather than one, while a `media` query on <source> would cost the ability to
 * switch modes without reloading.
 */
import type { ImageMetadata } from "astro"
import { Picture } from "astro:assets"

interface Props {
  light: ImageMetadata
  dark: ImageMetadata
  /** Alt text for the light version. Empty for decorative screenshots. */
  alt: string
  /** Alt text for the dark version; defaults to the light one. */
  altDark?: string
  widths: number[]
  sizes: string
  /** Classes for both <img> elements. */
  imageClass?: string
  /** This is the page's LCP image. */
  eager?: boolean
}

const {
  light,
  dark,
  alt,
  altDark = alt,
  widths,
  sizes,
  imageClass,
  eager = false,
} = Astro.props

---

<div class="dark:hidden">
  <Picture
    src={light}
    formats={["avif"]}
    fallbackFormat="webp"
    widths={widths}
    sizes={sizes}
    alt={alt}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : "auto"}
    class={imageClass}
  />
</div>
<div class="hidden dark:block">
  <Picture
    src={dark}
    formats={["avif"]}
    fallbackFormat="webp"
    widths={widths}
    sizes={sizes}
    alt={altDark}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : "auto"}
    class={imageClass}
  />
</div>
