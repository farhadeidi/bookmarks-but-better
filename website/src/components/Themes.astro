---
// The themes, shown in a real screenshot. Picking one happens in the hero's
// live preview (its theme dots), which the link below starts.
import themesDark from "../assets/screenshots/themes-dark.png"
import themesLight from "../assets/screenshots/themes-light.png"
import { SCREENSHOT, TEXT_LINK } from "../lib/ui"
import HeadingGroup from "./HeadingGroup.astro"
import ModeImage from "./ModeImage.astro"
import Section from "./Section.astro"
---

<Section id="themes" labelledby="themes-title">
  <div class="grid gap-x-12 gap-y-12 lg:grid-cols-3 lg:items-center">
    <HeadingGroup
      id="themes-title"
      eyebrow="Themes"
      title="Ten themes, each in light and dark"
      description="From Vintage Paper to Cyberpunk, every theme comes with light, dark and system modes."
    >
      <p class="mt-8 text-base/7 sm:text-sm/6">
        <a href="#demo" class={TEXT_LINK} data-demo-link>
          Try them in the live demo
        </a>
      </p>
    </HeadingGroup>
    <div class="lg:order-first lg:col-span-2">
      <ModeImage
        light={themesLight}
        dark={themesDark}
        alt="The dashboard in six of the color themes, each in light mode"
        altDark="The dashboard in six of the color themes, each in dark mode"
        widths={[640, 960, 1400]}
        sizes="(min-width: 1152px) 736px, (min-width: 1024px) 64vw, calc(100vw - 48px)"
        imageClass={`h-auto w-full ${SCREENSHOT}`}
      />
    </div>
  </div>
</Section>
