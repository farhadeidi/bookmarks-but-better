---
// The install buttons, named for the visitor's browser from <html
// data-browser> (set in Head.astro). Chromium browsers, and visitors without
// JavaScript, get Chrome as the primary (ink) button and Firefox beside it.
// Firefox moves its own button first and primary. Safari, which is
// daemon-only and built from source, gets its setup guide as the primary,
// with both stores after it.
import { SITE } from "../lib/site"
import { BUTTON, PRIMARY } from "../lib/ui"
import BrowserIcon from "./BrowserIcon.astro"

const ITEM = [BUTTON, "min-w-44 pr-4 pl-3"]
const ICON = "size-5 shrink-0 sm:size-4"
---

<div
  class="flex w-full max-w-xs flex-col gap-3 sm:w-auto sm:max-w-none sm:flex-row sm:flex-wrap sm:justify-center"
>
  <a
    href="/docs/start/safari/"
    class:list={[ITEM, PRIMARY, "order-first not-safari:hidden"]}
  >
    <BrowserIcon name="safari" class={ICON} />
    Get it for Safari
  </a>
  <a
    href={SITE.chromeStore}
    class:list={[
      ITEM,
      "bg-primary text-primary-foreground ring-primary hover:bg-primary/90 firefox:bg-card firefox:text-foreground firefox:ring-border firefox:hover:bg-muted safari:bg-card safari:text-foreground safari:ring-border safari:hover:bg-muted",
    ]}
  >
    <BrowserIcon name="chrome" class={ICON} />
    Add to Chrome
  </a>
  <a
    href={SITE.firefoxStore}
    class:list={[
      ITEM,
      "bg-card text-foreground ring-border hover:bg-muted firefox:order-first firefox:bg-primary firefox:text-primary-foreground firefox:ring-primary firefox:hover:bg-primary/90",
    ]}
  >
    <BrowserIcon name="firefox" class={ICON} />
    Add to Firefox
  </a>
</div>
