---
interface Props {
  /** Catalog-style index number, e.g. "01". */
  index: string
  title: string
  id: string
}

const { index, title, id } = Astro.props
---

<section id={id} aria-labelledby={`${id}-title`} class="border-t border-border">
  <div class="mx-auto max-w-6xl px-6 py-16 md:py-24">
    <div class="flex items-center gap-4" aria-hidden="true">
      <p class="font-display text-sm text-primary italic">{index} —</p>
      <span class="h-px flex-1 bg-border"></span>
    </div>
    <h2
      id={`${id}-title`}
      class="font-display mt-4 max-w-[40ch] text-3xl font-medium tracking-tight text-balance md:text-4xl"
    >
      {title}
    </h2>
    <div class="mt-10">
      <slot />
    </div>
  </div>
</section>
