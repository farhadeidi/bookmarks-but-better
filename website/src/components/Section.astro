---
// A landing page section: a full-width hairline on top, like the header's,
// and the page's one content column inside.
interface Props {
  id?: string
  labelledby: string
  class?: string
}

const { id, labelledby, class: className } = Astro.props
---

<section
  id={id}
  aria-labelledby={labelledby}
  class="scroll-mt-14 border-t border-border py-14 md:py-28"
>
  <div class:list={["mx-auto max-w-6xl px-6", className]}>
    <slot />
  </div>
</section>
