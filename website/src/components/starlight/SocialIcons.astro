---
// The header's site links, then Starlight's GitHub icon. "Docs" is left out
// here because the site title already links to it.
import Default from "@astrojs/starlight/components/SocialIcons.astro"
import { SITE_LINKS } from "../../lib/nav"

const links = SITE_LINKS.filter((link) => link.href !== "/docs/")
---

{
  links.map((link) => (
    <a href={link.href} class="site-link">
      {link.label}
    </a>
  ))
}
<Default />

<style>
  .site-link {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    text-decoration: none;
    white-space: nowrap;
  }
  .site-link:hover {
    color: var(--sl-color-white);
  }
</style>
