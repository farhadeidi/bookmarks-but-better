---
// The docs header's title: the brand links back to the main site, "Docs" to
// the docs home.
import { SITE } from "../../lib/site"
---

<div class="bbb-title">
  <a href="/" class="home">
    <img src="/logo-dark.svg" alt="" width="24" height="24" class="logo light" />
    <img src="/logo.svg" alt="" width="24" height="24" class="logo dark" />
    <span class="name" translate="no">{SITE.name}</span>
  </a>
  <span class="divider" aria-hidden="true"></span>
  <a href="/docs/" class="docs">Docs</a>
</div>

<style>
  .bbb-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }
  a {
    text-decoration: none;
    white-space: nowrap;
  }
  .home {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
    font-family: var(--bbb-font-display);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--sl-color-white);
  }
  .name {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .logo {
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
  }
  .dark,
  :global([data-theme="dark"]) .light {
    display: none;
  }
  :global([data-theme="dark"]) .dark {
    display: block;
  }
  .divider {
    flex-shrink: 0;
    width: 1px;
    height: 1.25rem;
    background: var(--sl-color-gray-5);
  }
  .docs {
    font-size: var(--sl-text-sm);
    font-weight: 500;
    color: var(--sl-color-text-accent);
  }
  .home:hover,
  .docs:hover {
    color: var(--sl-color-accent);
  }
  @media (max-width: 30rem) {
    .name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
