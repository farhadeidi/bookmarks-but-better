---
import { SITE } from "../lib/site"
import AppPreview from "./AppPreview.astro"
import InstallButtons from "./InstallButtons.astro"

const LINK =
  "text-muted-foreground underline decoration-border underline-offset-4 hover:text-foreground"
---

<section class="relative overflow-hidden" aria-labelledby="hero-title">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-64 bg-linear-to-b from-primary/8 to-transparent"
    aria-hidden="true"
  >
  </div>
  <div
    class="relative mx-auto max-w-6xl px-6 pt-16 pb-16 text-center md:pt-24 md:pb-24"
  >
    <p
      class="inline-flex items-center gap-2 rounded-full border border-border bg-card px-3 py-1 text-sm text-muted-foreground"
    >
      <span class="size-1.5 rounded-full bg-primary" aria-hidden="true"></span>
      Free and open source (MIT) · Chrome and Firefox
    </p>
    <h1
      id="hero-title"
      class="font-display mx-auto mt-8 max-w-[20ch] text-6xl font-medium tracking-tight md:text-8xl"
    >
      Bookmarks,{" "}<br /><span class="italic">but better</span>
    </h1>
    <p
      class="mx-auto mt-8 max-w-[52ch] text-lg/8 text-pretty text-muted-foreground md:text-xl/9"
    >
      {SITE.tagline}
    </p>
    <div class="mt-8 flex flex-col items-center gap-4">
      <InstallButtons class="justify-center" />
      <p
        class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm"
      >
        <a href="/preview/" class={LINK}>Open the full-screen preview</a>
        <span class="hidden text-border sm:inline" aria-hidden="true">·</span>
        <a href="/docs/start/safari/" class={LINK}>Using Safari?</a>
        <span class="hidden text-border sm:inline" aria-hidden="true">·</span>
        <a href={SITE.repository} class={LINK}>Source on GitHub</a>
      </p>
    </div>
    <div class="mt-14 md:mt-20">
      <AppPreview />
    </div>
  </div>
</section>
