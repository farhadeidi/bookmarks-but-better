---
import { SITE } from "../lib/site"
import { TEXT_LINK } from "../lib/ui"
import AppPreview from "./AppPreview.astro"
import InstallButtons from "./InstallButtons.astro"
---

<section aria-labelledby="hero-title" class="pt-12 pb-14 md:pt-24 md:pb-28">
  <div class="mx-auto max-w-6xl px-6 text-center">
    <p class="text-sm/6 font-medium text-accent">
      A free and open source bookmark manager for Chrome and Firefox
    </p>
    <h1
      id="hero-title"
      class="font-display mx-auto mt-5 max-w-[20ch] text-6xl font-semibold tracking-[-0.035em] text-balance sm:text-7xl md:text-8xl"
    >
      Bookmarks,{" "}<br />but <em class="font-normal not-italic">better</em>
    </h1>
    <p
      class="mx-auto mt-6 max-w-[48ch] text-lg/8 text-pretty text-muted-foreground md:mt-8"
    >
      {SITE.tagline}
    </p>
    <div class="mt-8 flex flex-col items-center gap-6 md:mt-10">
      <InstallButtons />
      <p
        class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-base/7 sm:text-sm/6"
      >
        <a href="/preview/" class={TEXT_LINK}>Try the live demo</a>
        <a
          href="/docs/start/safari/"
          class:list={[TEXT_LINK, "safari:hidden"]}
        >
          Using Safari?
        </a>
      </p>
    </div>
    <div class="mt-12 md:mt-20">
      <AppPreview />
    </div>
  </div>
</section>
