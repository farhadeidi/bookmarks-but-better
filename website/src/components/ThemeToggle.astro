---
/**
 * The dark/light toggle for both the marketing pages and the Starlight header,
 * so it is styled with plain CSS that falls back to Starlight's variables.
 */
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-label="Dark mode"
  aria-pressed="false"
>
  <svg
    class="icon-moon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
  </svg>
  <svg
    class="icon-sun"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"
    ></path>
  </svg>
</button>

<script>
  import { SITE_THEME_KEY, STARLIGHT_THEME_KEY } from "../lib/theme-init"

  const root = document.documentElement
  const buttons = document.querySelectorAll<HTMLButtonElement>(
    "[data-theme-toggle]"
  )

  const sync = () => {
    const dark = root.classList.contains("dark")
    buttons.forEach((button) =>
      button.setAttribute("aria-pressed", String(dark))
    )
  }

  buttons.forEach((button) =>
    button.addEventListener("click", () => {
      const dark = !root.classList.contains("dark")
      const mode = dark ? "dark" : "light"
      root.classList.toggle("dark", dark)
      root.dataset.theme = mode
      try {
        localStorage.setItem(SITE_THEME_KEY, mode)
        localStorage.setItem(STARLIGHT_THEME_KEY, mode)
      } catch {
        /* storage unavailable */
      }
      sync()
    })
  )
  sync()
</script>

<style>
  .theme-toggle {
    position: relative;
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--border, var(--sl-color-gray-5));
    border-radius: 0.375rem;
    background: transparent;
    color: var(--muted-foreground, var(--sl-color-gray-2));
    cursor: pointer;
  }
  .theme-toggle:hover {
    background: var(--muted, var(--sl-color-gray-6));
    color: var(--foreground, var(--sl-color-white));
  }
  .theme-toggle:focus-visible {
    outline: 2px solid var(--ring, var(--sl-color-accent));
    outline-offset: 2px;
  }
  svg {
    width: 1rem;
    height: 1rem;
  }
  .icon-sun,
  :global(.dark) .icon-moon {
    display: none;
  }
  :global(.dark) .icon-sun {
    display: block;
  }
</style>
