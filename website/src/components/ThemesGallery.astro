---
import { DEMO_THEMES } from "../lib/themes"
import Section from "./Section.astro"
---

<Section index="04" title="Ten themes, one calm dashboard" id="themes">
  <p class="max-w-2xl text-pretty text-muted-foreground">
    Every theme comes with light, dark and system modes. Pick one to see it in
    the live preview above, or{" "}
    <a
      href="/preview/"
      class="text-foreground underline decoration-primary/60 underline-offset-4 hover:text-primary"
    >
      open the full-screen preview
    </a>{" "}
    and change it in the app's own settings.
  </p>
  <ul
    role="list"
    class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-5"
  >
    {
      DEMO_THEMES.map((theme) => (
        <li>
          <button
            type="button"
            data-pick-theme={theme.id}
            class="group w-full overflow-hidden rounded-lg bg-card text-left ring-1 ring-border focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          >
            <span
              class="block h-16 w-full transition-transform duration-300 group-hover:scale-105"
              style={`background: linear-gradient(135deg, ${theme.accent} 0%, ${theme.accent}cc 55%, ${theme.accent}55 100%)`}
              aria-hidden="true"
            />
            <span class="block px-3 py-2.5 text-sm font-medium">
              {theme.name}
            </span>
          </button>
        </li>
      ))
    }
  </ul>
</Section>

<script>
  import { PICK_THEME_EVENT } from "../scripts/app-preview"

  document
    .querySelectorAll<HTMLButtonElement>("[data-pick-theme]")
    .forEach((button) =>
      button.addEventListener("click", () => {
        window.dispatchEvent(
          new CustomEvent(PICK_THEME_EVENT, {
            detail: button.dataset.pickTheme,
          })
        )
        const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches
        document
          .getElementById("demo")
          ?.scrollIntoView({ behavior: reduce ? "auto" : "smooth" })
      })
    )
</script>
