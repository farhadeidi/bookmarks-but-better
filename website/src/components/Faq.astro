---
import type { FaqItem } from "../lib/faq-items"
import Section from "./Section.astro"

interface Props {
  items: FaqItem[]
}

const { items } = Astro.props
---

<Section index="05" title="Questions, answered" id="faq">
  <div class="divide-y divide-border rounded-lg bg-card ring-1 ring-border">
    {
      items.map((item) => (
        <details class="group px-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-base font-medium marker:hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary sm:text-sm [&::-webkit-details-marker]:hidden">
            {item.question}
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke-width="1.8"
              class="size-4 shrink-0 stroke-muted-foreground transition-transform group-open:rotate-45"
              aria-hidden="true"
            >
              <path d="M12 5v14M5 12h14" />
            </svg>
          </summary>
          <p class="pb-4 text-base/7 text-pretty text-muted-foreground sm:text-sm/6">
            {item.answer}
            {item.link && (
              <>
                {" "}
                <a
                  href={item.link.href}
                  class="text-foreground underline decoration-primary/60 underline-offset-4 hover:text-primary"
                >
                  {item.link.label}
                </a>
              </>
            )}
          </p>
        </details>
      ))
    }
  </div>
</Section>
