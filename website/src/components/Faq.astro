---
import { Icon } from "@astrojs/starlight/components"
import type { FaqItem } from "../lib/faq-items"
import { SITE } from "../lib/site"
import { TEXT_LINK } from "../lib/ui"
import HeadingGroup from "./HeadingGroup.astro"
import Section from "./Section.astro"

interface Props {
  items: FaqItem[]
}

const { items } = Astro.props
---

<Section id="faq" labelledby="faq-title">
  <div class="grid gap-x-12 gap-y-10 lg:grid-cols-3 lg:gap-y-12">
    <div class="lg:sticky lg:top-24 lg:self-start">
      <HeadingGroup id="faq-title" eyebrow="FAQ" title="Questions, answered">
        <p
          class="mt-5 max-w-[48ch] text-lg/8 text-pretty text-muted-foreground"
        >
          Anything else? The <a href="/docs/" class={TEXT_LINK}>docs</a> cover
          every setup step, and you can ask on{" "}
          <a href={SITE.issues} class={TEXT_LINK}>GitHub</a>.
        </p>
      </HeadingGroup>
    </div>
    <div class="divide-y divide-border lg:col-span-2">
      {
        items.map((item) => (
          <details class="group py-6 first:pt-0 last:pb-0">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 rounded-sm text-lg/7 font-medium marker:hidden focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring sm:text-base/7 [&::-webkit-details-marker]:hidden">
              {item.question}
              <Icon
                name="down-caret"
                class="h-lh w-6 shrink-0 text-muted-foreground transition-transform group-open:rotate-180"
              />
            </summary>
            <p class="mt-3 max-w-[65ch] text-base/7 text-pretty text-muted-foreground">
              {item.answer}
              {item.link && (
                <>
                  {" "}
                  <a href={item.link.href} class={TEXT_LINK}>
                    {item.link.label}
                  </a>
                </>
              )}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</Section>
