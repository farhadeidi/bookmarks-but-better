---
import dashboardDark from "../assets/screenshots/dashboard-dark.png"
import dashboardLight from "../assets/screenshots/dashboard-light.png"
import { DEFAULT_DEMO_THEME, DEMO_THEMES } from "../lib/themes"
import ModeImage from "./ModeImage.astro"

const defaultTheme = DEMO_THEMES.find((theme) => theme.id === DEFAULT_DEMO_THEME)
---

<figure
  id="demo"
  class="relative isolate scroll-mt-20"
  data-app-preview
  data-default-theme={DEFAULT_DEMO_THEME}
>
  <div
    class="relative overflow-hidden rounded-xl bg-card shadow-2xl ring-1 shadow-foreground/10 ring-foreground/10 dark:shadow-none"
  >
    <div
      class="flex items-center gap-3 border-b border-border bg-muted/60 px-4 py-2.5"
      aria-hidden="true"
    >
      <div class="flex gap-1.5">
        <span class="size-2.5 rounded-full bg-foreground/15"></span>
        <span class="size-2.5 rounded-full bg-foreground/15"></span>
        <span class="size-2.5 rounded-full bg-foreground/15"></span>
      </div>
      <div
        class="flex h-7 max-w-xs flex-1 items-center rounded-md border border-border bg-background px-3 text-sm text-muted-foreground"
      >
        New Tab
      </div>
    </div>
    <div class="relative" data-preview-stage>
      <ModeImage
        light={dashboardLight}
        dark={dashboardDark}
        alt="The Bookmarks But Better dashboard in light mode: bookmark folders as cards in a masonry grid"
        altDark="The Bookmarks But Better dashboard in dark mode: bookmark folders as cards in a masonry grid"
        widths={[640, 960, 1280, 1400]}
        sizes="(min-width: 1152px) 1104px, calc(100vw - 48px)"
        imageClass="h-auto w-full"
        eager
      />
      <div
        class="absolute inset-0 grid place-items-center bg-linear-to-t from-black/45 via-black/10 to-transparent"
      >
        <button
          type="button"
          data-preview-launch
          class="inline-flex items-center gap-2 rounded-lg bg-white py-3 pr-5 pl-4 text-base/6 font-medium text-neutral-950 shadow-lg shadow-black/25 hover:bg-neutral-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
        >
          <svg
            viewBox="0 0 24 24"
            class="size-4 shrink-0 fill-current"
            aria-hidden="true"
          >
            <path
              d="M7 4.5v15a1 1 0 0 0 1.5.86l12.5-7.5a1 1 0 0 0 0-1.72L8.5 3.64A1 1 0 0 0 7 4.5Z"
            ></path>
          </svg>
          Try it live
        </button>
      </div>
    </div>
  </div>

  <figcaption
    class="mt-4 flex flex-wrap items-center justify-center gap-x-4 gap-y-2"
  >
    <p class="text-base/7 text-muted-foreground sm:text-sm/6">
      The real app runs right here. Pick a theme:
    </p>
    <div class="flex flex-wrap items-center justify-center gap-0.5">
      {
        DEMO_THEMES.map((theme) => (
          <button
            type="button"
            title={theme.name}
            aria-label={`Preview the ${theme.name} theme`}
            aria-pressed={theme.id === DEFAULT_DEMO_THEME ? "true" : "false"}
            data-preview-theme={theme.id}
            class="group relative grid size-7 place-items-center rounded-full focus-visible:outline-2 focus-visible:outline-offset-0 focus-visible:outline-ring"
          >
            <span
              class="size-4 rounded-full bg-(--swatch) ring-1 ring-foreground/15 ring-offset-2 ring-offset-background transition-transform group-hover:scale-110 group-aria-pressed:ring-2 group-aria-pressed:ring-foreground"
              style={`--swatch: ${theme.accent}`}
            />
            <span
              class="absolute top-1/2 left-1/2 size-[max(100%,3rem)] -translate-1/2 pointer-fine:hidden"
              aria-hidden="true"
            />
          </button>
        ))
      }
    </div>
    <p class="text-base/7 font-medium text-foreground sm:text-sm/6">
      <span data-preview-theme-name>{defaultTheme?.name}</span>
    </p>
  </figcaption>
</figure>

<script>
  import { initAppPreviews } from "../scripts/app-preview"

  initAppPreviews()
</script>
