---
import type { ImageMetadata } from "astro"
import organizerDark from "../assets/screenshots/organizer-dark.png"
import organizerLight from "../assets/screenshots/organizer-light.png"
import searchDark from "../assets/screenshots/search-dark.png"
import searchLight from "../assets/screenshots/search-light.png"
import sourcesDark from "../assets/screenshots/sources-dark.png"
import sourcesLight from "../assets/screenshots/sources-light.png"
import { SCREENSHOT } from "../lib/ui"
import HeadingGroup from "./HeadingGroup.astro"
import ModeImage from "./ModeImage.astro"
import Section from "./Section.astro"

// The dashboard itself is the hero's screenshot, so it is not repeated here.
const SHOWN: {
  title: string
  description: string
  light: ImageMetadata
  dark: ImageMetadata
}[] = [
  {
    title: "A real organizer, with drag and drop",
    description:
      "Drag bookmarks between folders, reorder, rename, create and delete in a full tree editor.",
    light: organizerLight,
    dark: organizerDark,
  },
  {
    title: "Find any bookmark in a keystroke",
    description:
      "Start typing anywhere on the dashboard. The search palette finds bookmarks in the active source by title or URL.",
    light: searchLight,
    dark: searchDark,
  },
  {
    title: "Your sources, your root folder",
    description:
      "Switch between browser bookmarks and Markdown vaults from the header, and start the dashboard from any folder.",
    light: sourcesLight,
    dark: sourcesDark,
  },
]

const LISTED = [
  {
    title: "Import from anywhere",
    description:
      "Bring a bookmarks HTML file from any browser, or CSV exports from Raindrop and Pocket. Export to HTML whenever you like.",
  },
  {
    title: "Quick capture",
    description:
      "Save the page you are on from the toolbar popup, straight into the active source.",
  },
  {
    title: "Search from the address bar",
    description:
      "In Chrome and Firefox, type bb and press Tab in the address bar to search without opening the dashboard.",
  },
]

const TERM = "text-base/7 font-medium text-foreground"
const DETAIL = "text-base/7 text-pretty text-muted-foreground sm:text-sm/6"
---

<Section id="features" labelledby="features-title">
  <HeadingGroup
    id="features-title"
    eyebrow="Features"
    title="A bookmarks dashboard that earns your new tab"
    description="Every bookmark folder becomes a card. Open a new tab and your library is right there, not a search box."
  />
  <dl class="mt-10 grid gap-x-12 gap-y-10 md:mt-16 md:grid-cols-3 md:gap-y-14">
    {
      SHOWN.map((feature) => (
        <div class="flex flex-col gap-2">
          <dt class={TERM}>{feature.title}</dt>
          <dd class={DETAIL}>{feature.description}</dd>
          <dd class="order-first pb-4">
            <ModeImage
              light={feature.light}
              dark={feature.dark}
              alt=""
              widths={[480, 720, 1080]}
              sizes="(min-width: 1152px) 336px, (min-width: 768px) 30vw, calc(100vw - 48px)"
              imageClass={`aspect-16/10 h-auto w-full ${SCREENSHOT}`}
            />
          </dd>
        </div>
      ))
    }
  </dl>
  <dl class="mt-10 grid gap-x-12 gap-y-8 md:mt-16 md:grid-cols-3">
    {
      LISTED.map((feature) => (
        <div class="flex flex-col gap-2 border-t border-border pt-6">
          <dt class={TERM}>{feature.title}</dt>
          <dd class={DETAIL}>{feature.description}</dd>
        </div>
      ))
    }
  </dl>
</Section>
