{
  "manifest_version": 3,
  "name": "Bookmarks But Better",
  "description": "A bookmarks dashboard backed by a local daemon. Themes, dark mode, full management. Reads the current page only when you click Save.",
  "version": "4.1.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save bookmark"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://t1.gstatic.com/*", "https://www.google.com/*"],
  "optional_host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
