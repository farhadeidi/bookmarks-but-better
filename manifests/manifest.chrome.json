{
  "manifest_version": 3,
  "name": "Bookmarks But Better",
  "description": "A clean, beautiful bookmarks dashboard for your new tab with themes, dark mode, and full bookmark management.",
  "version": "4.1.0",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save bookmark"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "omnibox": {
    "keyword": "bb"
  },
  "permissions": [
    "activeTab",
    "bookmarks",
    "storage",
    "favicon",
    "clipboardWrite"
  ],
  "host_permissions": ["https://t1.gstatic.com/*", "https://www.google.com/*"],
  "optional_host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
